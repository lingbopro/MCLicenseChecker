{
  "schemaVersion": 1,
  "id": "licensechecker",
  "version": "${version}",
  "name": "LicenseChecker",
  "description": "Quickly check the licenses of installed mods.",
  "authors": [
    "lingbopro"
  ],
  "contact": {
    "homepage": "https://github.com/lingbopro/MCLicenseChecker"
  },
  "license": "MIT",
  "icon": "assets/licensechecker/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.lingbopro.licensechecker.fabric.LicenseCheckerFabric"
    ],
    "client": [
      "me.lingbopro.licensechecker.fabric.client.LicenseCheckerFabricClient"
    ],
    "modmenu": [ "me.lingbopro.licensechecker.fabric.client.ModMenuApiImpl" ]
  },
  "mixins": [
    "licensechecker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": ">=11.0.0"
  }
}
